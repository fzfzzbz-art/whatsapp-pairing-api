# =====================================================
# Environment variables for the Telegram bot
# Copy this file to `.env` on your host and edit values.
# =====================================================

# --- Bot identity ---
BOT_TOKEN=8961523589:AAE90t5BR77HdgcJnHKPeN9XMgPgeMRVnU4
ADMIN_ID=7231690686

# --- Hosting (FREE HOSTS) ---
# Render/Railway/Koyeb/Heroku all set PORT automatically.
# If your host does NOT, set it manually:
PORT=8080

# Free Python-only hosts usually have no Node.js. Set this to "true"
# so the bot skips the embedded companion (Node.js) and uses the
# public pairing API instead. This PREVENTS the crash that closed
# the file out of the host.
DISABLE_EMBEDDED_COMPANION=true
PYTHON_ONLY_HOSTING=true

# --- Pairing API (used when embedded companion is disabled) ---
PAIR_CODE_API_URL=https://bwt-lwts.onrender.com/api/pairing

# --- Green API (optional, only if you want it) ---
GREEN_API_BASE_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
GREEN_API_PHONE_NUMBER=

# --- Database (MongoDB optional; bot falls back to local files) ---
MONGODB_URI=mongodb+srv://faresomar79:faresaltmimi99@cluster0.0tb0uf9.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=whatsapp_pairing_api

# --- Webhook security (optional) ---
WEBHOOK_SECRET=

# --- Channel / forced subscription (optional) ---
FORCE_SUB_ENABLED=false
FORCE_SUB_CHANNEL=
FORCE_SUB_URL=
AUTO_REPLY_CHANNEL_URL=https://bwt-lwts.onrender.com
